# videoprocessor environment variables (example)
#
# Copy to ".env" and adjust as needed. docker-compose.yml already sets sensible
# defaults per service; values here document every knob in one place and are the
# defaults the code falls back to when a variable is unset.

# --------------------------------------------------------------------------- #
# Logging (all services, via common.py)
# --------------------------------------------------------------------------- #
LOG_LEVEL=INFO            # DEBUG / INFO / WARNING / ERROR
LOG_FORMAT=json           # "json" (single-line JSON) or "plain"

# --------------------------------------------------------------------------- #
# Resilient HTTP / retry (all services, via common.post_with_retry)
# --------------------------------------------------------------------------- #
HTTP_MAX_RETRIES=3        # Retries before giving up on an outbound POST
HTTP_BACKOFF_BASE=1.0     # Base backoff seconds (doubles each retry)
HTTP_TIMEOUT=30           # Per-request timeout (seconds)

# --------------------------------------------------------------------------- #
# Input validation / size limits (processing services, via common)
# --------------------------------------------------------------------------- #
MAX_VIDEO_SIZE_MB=0       # Reject inputs larger than this (0 = unlimited)
MAX_TRANSCRIPT_CHARS=200000   # ai-caption-agent: reject longer transcripts (0 = unlimited)

# --------------------------------------------------------------------------- #
# video-scraper
# --------------------------------------------------------------------------- #
INPUT_DIR=/app/input
PROCESSING_DIR=/app/processing
SCAN_INTERVAL=30          # Watcher loop interval (seconds)
FILE_STABLE_TIMEOUT=30    # Max seconds to wait for an upload to finish writing
FILE_STABLE_INTERVAL=1.0  # Poll interval while waiting for a stable size
PORT=5001

# --------------------------------------------------------------------------- #
# video-processor
# --------------------------------------------------------------------------- #
OUTPUT_DIR=/app/output
SHORTS_DURATION_THRESHOLD=60   # Seconds at/under which a clip is a vertical Short
OUTPUT_PREFIX=processed_       # Output filename prefix
OUTPUT_CONTAINER=mp4           # Output container/extension (without the dot)
PORT=5000

# --------------------------------------------------------------------------- #
# caption-generator
# --------------------------------------------------------------------------- #
WHISPER_MODEL=base        # tiny / base / small / medium / large
PORT=5002

# --------------------------------------------------------------------------- #
# ai-caption-agent (Ollama)
# --------------------------------------------------------------------------- #
OLLAMA_API_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TEMPERATURE=0.7
OLLAMA_TOP_P=0.9
OLLAMA_TOP_K=40
OLLAMA_TIMEOUT=120        # Generation request timeout (seconds)
OLLAMA_READY_RETRIES=5    # Startup readiness retries
OLLAMA_READY_WAIT=5.0     # Seconds between readiness checks
PORT=5003

# --------------------------------------------------------------------------- #
# file-assembler
# --------------------------------------------------------------------------- #
# OUTPUT_DIR=/app/output (shared with video-processor)
PORT=5004

# --------------------------------------------------------------------------- #
# n8n webhook URLs (one per service; defaults point at the n8n container)
# --------------------------------------------------------------------------- #
# N8N_WEBHOOK_URL is set per-service in docker-compose.yml.

# --------------------------------------------------------------------------- #
# orchestrator.py (host CLI only; not used by containers)
# --------------------------------------------------------------------------- #
SCRAPER_URL=http://localhost:5001
PROCESSOR_URL=http://localhost:5000
CAPTION_URL=http://localhost:5002
AI_CAPTION_URL=http://localhost:5003
ASSEMBLER_URL=http://localhost:5004
HOST_INPUT_DIR=shared-storage/input
DEAD_LETTER_DIR=shared-storage/failed   # Where "run" records failed/timed-out jobs
